{
  "name": "zombiebox-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "android": "react-native run-android",
    "codegen": "node scripts/codegen.cjs",
    "git-info": "node scripts/write-git-info.cjs",
    "postinstall": "node scripts/write-git-info.cjs",
    "start": "react-native start",
    "typecheck": "node scripts/write-git-info.cjs && tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/codegen": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  },
  "codegenConfig": {
    "name": "ZombieboxSpec",
    "type": "components",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "game.zombiebox.mobile"
    },
    "ios": {
      "componentProvider": {
        "ZombieboxSurface": "RCTZombieboxSurface"
      }
    }
  }
}
